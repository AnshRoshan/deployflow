DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
SECRET_ENCRYPTION_KEY=
# Optional live GitHub repository discovery. Fine-grained tokens are entered in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional SMTP for password reset, verification, and team invitation email.
SMTP_URL=
EMAIL_FROM=DeployFlow <noreply@your-domain.com>
# Public HTTPS origin; required for externally configured GitHub OAuth/webhooks.
APP_URL=
